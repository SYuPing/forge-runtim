{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-runtime/schemas/grill-result.schema.json",
  "title": "StructuredGrillResult",
  "type": "object",
  "required": [
    "status",
    "questions",
    "recommendation",
    "evidence",
    "requiresUserConfirmation",
    "roundId"
  ],
  "properties": {
    "status": {
      "enum": ["NEEDS_CONFIRMATION", "READY_FOR_DEEP"]
    },
    "questions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "question", "options"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "required": ["value"],
                  "properties": {
                    "id": { "type": "string" },
                    "value": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiresUserConfirmation": {
      "type": "boolean"
    },
    "roundId": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "NEEDS_CONFIRMATION" }
        }
      },
      "then": {
        "properties": {
          "questions": { "minItems": 1, "maxItems": 1 },
          "requiresUserConfirmation": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "READY_FOR_DEEP" }
        }
      },
      "then": {
        "properties": {
          "questions": { "minItems": 0, "maxItems": 0 },
          "requiresUserConfirmation": { "const": false }
        }
      }
    }
  ],
  "additionalProperties": false
}
