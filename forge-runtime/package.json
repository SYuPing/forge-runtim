{
  "name": "forge-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/forge-runtime.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.pi-interactive.check.json",
